# Nginx для порталу «Хмарний робочий стіл». ${CD_DOMAIN} підставляється з .env під час запуску.
# Портал і столи слухають лише 127.0.0.1 — назовні відкрито тільки 80 і 443.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Уся аудиторія часто виходить через одну IP-адресу (NAT), тому ліміт щедрий:
# точний захист від перебору (5 спроб на логін) робить сам портал.
limit_req_zone $binary_remote_addr zone=login:10m rate=120r/m;

server {
    listen 80;
    # listen [::]:80;   # розкоментуйте, якщо на сервері є IPv6
    server_name ${CD_DOMAIN};

    # Перевірка домену для Let's Encrypt (scripts/letsencrypt.sh)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    # listen [::]:443 ssl;
    http2 on;
    server_name ${CD_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 210m;   # трохи більше за CD_MAX_UPLOAD_MB

    # Увага: location, де є власні proxy_set_header, ці заголовки НЕ успадковує.
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # --- робочі столи: /desktop/<id>/... → контейнер студента ---------------------
    # /desktop/<id>/ — керування, /desktop/<id>-view/ — лише перегляд (для викладача)
    location ~ ^/desktop/(?<desk_id>[0-9]+(-view)?)/(?<desk_path>.*)$ {
        auth_request /_desktop_auth;
        auth_request_set $desk_upstream $upstream_http_x_desktop_upstream;
        auth_request_set $desk_auth     $upstream_http_x_desktop_auth;

        # KasmVNC працює по HTTPS з самопідписаним сертифікатом усередині контейнера.
        proxy_pass https://$desk_upstream/$desk_path$is_args$args;
        proxy_ssl_verify off;
        proxy_ssl_server_name off;
        # Basic-пароль KasmVNC підставляє Nginx — у браузер студента він не потрапляє.
        proxy_set_header Authorization $desk_auth;
        proxy_set_header Cookie "";

        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout  1d;
        proxy_send_timeout  1d;
        proxy_buffering     off;
    }

    location = /_desktop_auth {
        internal;
        proxy_pass http://127.0.0.1:8000/api/proxy/auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Real-IP $remote_addr;
    }

    error_page 401 = @login;
    location @login {
        return 302 /;
    }

    # --- портал ---------------------------------------------------------------------
    location = /api/auth/login {
        limit_req zone=login burst=100 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8000;
    }

    location = /metrics {
        deny all;   # Prometheus читає метрики напряму з 127.0.0.1:8000
    }

    location /grafana/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host       $host;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_read_timeout 300s;
        error_page 502 503 504 = @portal_down;
    }

    # Портал перезапускається (оновлення) — відкриті столи працюють далі, а тут показуємо пояснення.
    location @portal_down {
        default_type text/html;
        add_header Retry-After 15 always;
        return 503 '<!DOCTYPE html><html lang="uk"><meta charset="utf-8"><meta http-equiv="refresh" content="15"><title>Портал оновлюється</title><body style="font-family:sans-serif;text-align:center;padding:4rem;color:#1c2333"><h2>Портал оновлюється</h2><p>Спробуйте за хвилину — сторінка оновиться сама. Відкриті робочі столи продовжують працювати.</p></body></html>';
    }
}
