# Скопіюйте у .env і заповніть. Файл .env не можна комітити в git!
# Випадкові значення: openssl rand -base64 32

CD_DOMAIN=desk.college.edu.ua
CD_SECRET_KEY=замініть-на-випадковий-рядок-щонайменше-32-символи
MYSQL_PASSWORD=замініть
MYSQL_ROOT_PASSWORD=замініть

# Перший адміністратор (створюється при першому запуску; потім змініть пароль у профілі)
CD_ADMIN_USERNAME=admin
CD_ADMIN_PASSWORD=замініть-Пароль1

# Де зберігаються файли студентів і здані роботи
CD_STORAGE_ROOT=/srv/cloud-desktop

# Тег образів Kasm — перевірте актуальний на https://hub.docker.com/u/kasmweb
CD_KASM_TAG=1.17.0

# 1 — створити демо-групи, викладача teacher/Teacher123 і студентів student1..3/Student123
CD_DEMO_SEED=0

# Обмеження диска контейнера (лише Docker на XFS з pquota), напр. 10G. Порожньо — без обмеження.
CD_CONTAINER_DISK_SIZE=

GRAFANA_PASSWORD=замініть

# Група docker на сервері (заповнює scripts/install-server.sh): getent group docker | cut -d: -f3
DOCKER_GID=999

# --- Вхід через пошту коледжу (OpenID Connect), необов'язково ---------------------------
# Google Workspace:  CD_OIDC_ISSUER=https://accounts.google.com
# Microsoft 365:     CD_OIDC_ISSUER=https://login.microsoftonline.com/<ID-тенанта>/v2.0
# Адреса повернення, яку треба вказати в консолі провайдера: https://<CD_DOMAIN>/api/auth/oidc/callback
CD_OIDC_ISSUER=
CD_OIDC_CLIENT_ID=
CD_OIDC_CLIENT_SECRET=
CD_OIDC_ALLOWED_DOMAINS=college.edu.ua
# 1 — при першому вході створювати акаунт студента (без групи); 0 — лише для вже створених акаунтів з цією поштою
CD_OIDC_AUTO_CREATE=0
