{
 "uid": "cloud-desktop",
 "title": "Хмарний робочий стіл — навантаження",
 "schemaVersion": 39,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "30s",
 "timezone": "browser",
 "tags": [
  "cloud-desktop"
 ],
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Активні столи",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "cd_active_sessions"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Пам'ять зайнята",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.75
       },
       {
        "color": "red",
        "value": 0.9
       }
      ]
     },
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Навантаження CPU (1 хв / ядро)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.8
       },
       {
        "color": "red",
        "value": 1.2
       }
      ]
     },
     "min": 0,
     "max": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_load1 / scalar(count(count by (cpu) (node_cpu_seconds_total)))"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Входів за добу",
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "cd_logins_24h"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Столи за станом",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "stacking": {
       "mode": "normal"
      },
      "fillOpacity": 15
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "cd_sessions",
     "legendFormat": "{{status}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Пам'ять сервера",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "stacking": {
       "mode": "normal"
      },
      "fillOpacity": 15
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
     "legendFormat": "зайнято"
    },
    {
     "refId": "B",
     "expr": "node_memory_MemAvailable_bytes",
     "legendFormat": "вільно"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "CPU сервера",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "stacking": {
       "mode": "none"
      },
      "fillOpacity": 5
     },
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m]))",
     "legendFormat": "завантаження"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Диск сховища",
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "stacking": {
       "mode": "none"
      },
      "fillOpacity": 5
     },
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}",
     "legendFormat": "зайнято"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Скільки пам'яті на один активний стіл",
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "stacking": {
       "mode": "none"
      },
      "fillOpacity": 5
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / scalar(clamp_min(cd_active_sessions, 1))",
     "legendFormat": "на стіл"
    }
   ]
  }
 ]
}